# PLANTILLA de configuración.
# 1. Copiá este archivo y renombrá la copia a:  .env
# 2. En la copia, reemplazá TU_CLAVE_DE_POSTGRES por la contraseña del usuario postgres.
# El archivo .env NO se sube a GitHub (tiene contraseñas). Este .env.example sí.

DATABASE_URL=postgresql+psycopg://postgres:TU_CLAVE_DE_POSTGRES@localhost:5432/tesis_cgm

# Clave de la API de OpenAI (opcional). Se obtiene en platform.openai.com -> API keys.
# Sin clave, los eventos se cargan manualmente y el resumen diario se genera con una plantilla.
OPENAI_API_KEY=
